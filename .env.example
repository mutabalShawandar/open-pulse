# Local development environment for `docker compose up`. These are working
# defaults for running OpenPulse on your own machine only — never reuse them
# for a real deployment. Copy this file to `.env` and you can start the stack
# as-is; nothing here needs to be changed to get a local instance running.
#
# Cp this file to .env.production or .env.staging instead when deploying: see
# .env.production.example / .env.staging.example for that.

APP_ENV=development

POSTGRES_DB=openpulse
POSTGRES_USER=openpulse_user
POSTGRES_PASSWORD=openpulse_dev_password
POSTGRES_PORT=5432
KEYCLOAK_SCHEMA=keycloak

DATABASE_URL=postgresql+asyncpg://openpulse_user:openpulse_dev_password@postgres:5432/openpulse

APP_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used only by the frontend container's server-side code (Server Components,
# route handlers, middleware) to reach the backend over the Docker network.
# Leave unset when running the frontend with `npm run dev` on the host.
INTERNAL_API_BASE_URL=http://backend:8000
CORS_ORIGINS=http://localhost:3000

KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://localhost:8081/realms/openpulse
# Used only by the frontend container's server-side code to reach Keycloak
# over the Docker network. Leave unset when running with `npm run dev`.
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/openpulse
KEYCLOAK_REALM=openpulse
KEYCLOAK_CLIENT_ID=openpulse-frontend
KEYCLOAK_AUDIENCE=openpulse-api
KEYCLOAK_FRONTEND_CLIENT_ID=openpulse-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=openpulse-backend-admin
# Matches the "secret" hardcoded in docker/keycloak/local-realm/openpulse-realm.json.
# That file is committed for local development only; never reuse this value
# anywhere else.
KEYCLOAK_ADMIN_CLIENT_SECRET=openpulse-dev-admin-secret

# First-start-only Keycloak master-realm administrator (local dev only).
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=openpulse_dev_password

REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://storage:8333
MINIO_ACCESS_KEY=openpulse_dev_access_key
MINIO_SECRET_KEY=openpulse_dev_secret_key
MINIO_BUCKET=clinic-assets

EMAIL_CREDENTIAL_ENCRYPTION_KEY=toCL0iGX5as1uzRwwCVjBKsl3tD2jDdoi3F02Pmo4vo=
CAMPAIGN_DELIVERY_MAX_ATTEMPTS=3
CAMPAIGN_DELIVERY_RETRY_BASE_SECONDS=15

# The first local platform administrator, seeded automatically on first
# `docker compose up`. Sign in at http://localhost:3000 with these Keycloak
# credentials (local dev only).
SEED_ADMIN_EMAIL=admin@openpulse.local

# Self-serve organization registration (/register). Off for the single-organization first release.
ORGANIZATION_REGISTRATION_ENABLED=false
