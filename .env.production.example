# Copy this file to .env.production on the VPS. Never commit the copied file.
# Use a different file with different values/ports for staging.
DEPLOY_ENV_FILE=.env.production

APP_ENV=production
APP_POSTGRES_DB=umfrage
APP_POSTGRES_USER=umfrage_app
APP_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak_app
KEYCLOAK_POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# These ports are reachable only through localhost. Nginx proxies to them.
FRONTEND_HOST_PORT=13000
BACKEND_HOST_PORT=18000
KEYCLOAK_HOST_PORT=18080

APP_URL=https://app.example.de
PUBLIC_FRONTEND_URL=https://app.example.de
PUBLIC_BACKEND_URL=https://api.example.de
NEXT_PUBLIC_API_BASE_URL=https://api.example.de
NEXT_PUBLIC_ROOT_DOMAIN=example.de
PUBLIC_ROOT_DOMAIN=example.de
CORS_ORIGINS=https://app.example.de
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?example\.de

KEYCLOAK_URL=https://auth.example.de
KEYCLOAK_ISSUER=https://auth.example.de/realms/Umfrage
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=Umfrage
# Production uses `realm`; staging uses `realm-staging`.
KEYCLOAK_REALM_IMPORT_DIR=realm
KEYCLOAK_CLIENT_ID=umfrage-frontend
KEYCLOAK_AUDIENCE=umfrage-api
KEYCLOAK_FRONTEND_CLIENT_ID=umfrage-frontend
KEYCLOAK_CLIENT_SECRET=REPLACE_IF_THE_FRONTEND_CLIENT_IS_CONFIDENTIAL
KEYCLOAK_ADMIN_CLIENT_ID=umfrage-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=REPLACE_WITH_THE_REALM_SERVICE_CLIENT_SECRET
# Temporary, first-start-only Keycloak master-realm administrator. Remove both
# values after creating and testing the permanent master-realm administrator.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-bootstrap-admin
# On the VPS, generate a unique value with: openssl rand -base64 32
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
KEYCLOAK_SMTP_HOST=w00de7f6.kasserver.com
KEYCLOAK_SMTP_PORT=465
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_SSL=true
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_USERNAME=REPLACE_WITH_THE_FULL_MAILBOX_ADDRESS
KEYCLOAK_SMTP_PASSWORD=REPLACE_WITH_THE_MAILBOX_PASSWORD
KEYCLOAK_SMTP_FROM=REPLACE_WITH_THE_FULL_MAILBOX_ADDRESS
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Praxisumfrage
KEYCLOAK_SMTP_REPLY_TO=
KEYCLOAK_SMTP_ENVELOPE_FROM=
# Use a different subnet for staging, for example 172.29.0.0/24.
COMPOSE_SUBNET=172.28.0.0/24
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=172.28.0.1

REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://storage:8333
MINIO_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MINIO_BUCKET=clinic-assets
EMAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
CAMPAIGN_DELIVERY_MAX_ATTEMPTS=3
CAMPAIGN_DELIVERY_RETRY_BASE_SECONDS=15
