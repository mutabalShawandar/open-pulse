# Copy this file to the VPS as .env.staging. Never commit the copied file.
DEPLOY_ENV_FILE=.env.staging

APP_ENV=staging
APP_POSTGRES_DB=openpulse_staging
APP_POSTGRES_USER=openpulse_staging_app
APP_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
KEYCLOAK_POSTGRES_DB=keycloak_staging
KEYCLOAK_POSTGRES_USER=keycloak_staging_app
KEYCLOAK_POSTGRES_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Localhost-only ports; Nginx is the public entry point.
FRONTEND_HOST_PORT=13001
BACKEND_HOST_PORT=18001
KEYCLOAK_HOST_PORT=18081

APP_URL=https://staging-app.example.de
PUBLIC_FRONTEND_URL=https://staging-app.example.de
PUBLIC_BACKEND_URL=https://staging-api.example.de
NEXT_PUBLIC_API_BASE_URL=https://staging-api.example.de
NEXT_PUBLIC_ROOT_DOMAIN=example.de
PUBLIC_ROOT_DOMAIN=example.de
CORS_ORIGINS=https://staging-app.example.de
CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)?example\.de

KEYCLOAK_URL=https://staging-auth.example.de
KEYCLOAK_ISSUER=https://staging-auth.example.de/realms/openpulse-staging
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=openpulse-staging
KEYCLOAK_REALM_IMPORT_DIR=realm-staging
KEYCLOAK_CLIENT_ID=openpulse-frontend
KEYCLOAK_AUDIENCE=openpulse-api
KEYCLOAK_FRONTEND_CLIENT_ID=openpulse-frontend
KEYCLOAK_CLIENT_SECRET=REPLACE_IF_THE_FRONTEND_CLIENT_IS_CONFIDENTIAL
KEYCLOAK_ADMIN_CLIENT_ID=openpulse-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Temporary, first-start-only Keycloak master-realm administrator.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-bootstrap-admin-staging
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

KEYCLOAK_SMTP_HOST=w00de7f6.kasserver.com
KEYCLOAK_SMTP_PORT=465
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_SSL=true
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_USERNAME=REPLACE_WITH_THE_FULL_MAILBOX_ADDRESS
KEYCLOAK_SMTP_PASSWORD=REPLACE_WITH_THE_MAILBOX_PASSWORD
KEYCLOAK_SMTP_FROM=REPLACE_WITH_THE_FULL_MAILBOX_ADDRESS
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=OpenPulse Staging
KEYCLOAK_SMTP_REPLY_TO=
KEYCLOAK_SMTP_ENVELOPE_FROM=

COMPOSE_SUBNET=172.29.0.0/24
KEYCLOAK_PROXY_TRUSTED_ADDRESSES=172.29.0.1

REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://storage:8333
MINIO_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MINIO_BUCKET=clinic-assets-staging
EMAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY
CAMPAIGN_DELIVERY_MAX_ATTEMPTS=3
CAMPAIGN_DELIVERY_RETRY_BASE_SECONDS=15

# Self-serve organization registration (/register). Off for the single-organization first release.
ORGANIZATION_REGISTRATION_ENABLED=false
