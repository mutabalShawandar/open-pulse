{
  "realm": "openpulse",
  "enabled": true,
  "displayName": "OpenPulse (local)",
  "displayNameHtml": "OpenPulse (local)",
  "attributes": {
    "frontendUrl": "http://localhost:8081"
  },
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "passwordPolicy": "hashAlgorithm(argon2) and length(10) and notUsername and notEmail and passwordHistory(5)",
  "internationalizationEnabled": true,
  "supportedLocales": ["de"],
  "defaultLocale": "de",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "auth": "false",
    "starttls": "false",
    "ssl": "false",
    "from": "noreply@local.test",
    "fromDisplayName": "OpenPulse (local)"
  },
  "clients": [
    {
      "clientId": "openpulse-api",
      "name": "OpenPulse API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "openpulse-frontend",
      "name": "OpenPulse Frontend (local)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "openpulse-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "openpulse-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openpulse-backend-admin",
      "name": "OpenPulse Backend Administration (local)",
      "description": "Service account for backend user provisioning.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "openpulse-dev-admin-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-openpulse-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "openpulse-backend-admin",
      "realmRoles": ["default-roles-openpulse"],
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    },
    {
      "username": "admin",
      "email": "admin@openpulse.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "OpenPulse",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "openpulse-dev-admin",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-openpulse"]
    }
  ]
}
