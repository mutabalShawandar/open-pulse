{
  "realm": "openpulse-staging",
  "enabled": true,
  "displayName": "OpenPulse - Staging",
  "displayNameHtml": "OpenPulse - Staging",
  "attributes": {
    "frontendUrl": "${KEYCLOAK_URL}"
  },
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "passwordPolicy": "hashAlgorithm(argon2) and length(10) and notUsername and notEmail and passwordHistory(5)",
  "revokeRefreshToken": true,
  "accessCodeLifespan": 60,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "de"],
  "defaultLocale": "en",
  "smtpServer": {
    "password": "${KEYCLOAK_SMTP_PASSWORD}",
    "starttls": "${KEYCLOAK_SMTP_STARTTLS}",
    "auth": "${KEYCLOAK_SMTP_AUTH}",
    "port": "${KEYCLOAK_SMTP_PORT}",
    "host": "${KEYCLOAK_SMTP_HOST}",
    "replyTo": "${KEYCLOAK_SMTP_REPLY_TO}",
    "from": "${KEYCLOAK_SMTP_FROM}",
    "fromDisplayName": "${KEYCLOAK_SMTP_FROM_DISPLAY_NAME}",
    "envelopeFrom": "${KEYCLOAK_SMTP_ENVELOPE_FROM}",
    "ssl": "${KEYCLOAK_SMTP_SSL}",
    "user": "${KEYCLOAK_SMTP_USERNAME}"
  },
  "clients": [
    {
      "clientId": "openpulse-api",
      "name": "OpenPulse API (staging)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "openpulse-frontend",
      "name": "OpenPulse Frontend (staging)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${APP_URL}/auth/callback",
        "${APP_URL}/*"
      ],
      "webOrigins": ["${APP_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "openpulse-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "openpulse-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openpulse-backend-admin",
      "name": "OpenPulse Backend Administration (staging)",
      "description": "Service account for backend user provisioning.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-openpulse-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "openpulse-backend-admin",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
